<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules for API 31+: the app's Room database is the single
   source of truth (all totals/streaks/achievements are derived from it), so
   we include it explicitly — anything not included is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
